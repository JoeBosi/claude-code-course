{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(jq *)",
      "Bash(shellcheck *)",
      "Bash(bin/*.sh --dry-run*)",
      "Bash(git status*)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(bin/04-publish.sh*)",
      "Write(./data/raw/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(bin/*.sh)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/shellcheck.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stato.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-sessione.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
