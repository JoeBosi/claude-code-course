# Copiare in .env e riempire. .env NON si committa.
# `bin/run.sh` fa il source di questo file: serve perché cron ha un PATH minimo.

# PATH completo — cron ne ha uno ridotto e non troverebbe node, npx, gh, jq
export PATH="/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

# Percorso assoluto di claude. Trovalo con: command -v claude
export CLAUDE_BIN=

# Token per la CI e per cron. Generalo con: claude setup-token
export CLAUDE_CODE_OAUTH_TOKEN=

# Pubblicazione — attiva solo i canali che usi
# export PUBBLICA_SU_GITHUB=1
# export SLACK_WEBHOOK_URL=

# Le tue fonti dati
# export API_URL=
# export DATABASE_URL_RO=
