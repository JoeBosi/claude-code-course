# Copiare in .env.local e riempire. .env.local NON si committa.

# Supabase — dal pannello del progetto, Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server, mai esposta al browser. Usata solo dai webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Connessione diretta per le migrazioni Drizzle
DATABASE_URL=

# Token per il server MCP di Supabase (vedi .mcp.json)
SUPABASE_ACCESS_TOKEN=
