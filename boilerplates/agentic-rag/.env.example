# Copiare in .env e riempire. .env NON si committa.

# Modello usato dal gateway LLM
LLM_MODEL=claude-sonnet-5

# Dove Chroma persiste. NON usare questa directory nei test.
CHROMA_PATH=./chroma

# Documenti da indicizzare — usato anche dal server MCP filesystem
DOCS_DIR=./docs

# Database in SOLA LETTURA per il server MCP `db`
DATABASE_URL_RO=
