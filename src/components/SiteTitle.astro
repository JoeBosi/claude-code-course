---
// Override del titolo nell'header: sotto il nome del corso resta sempre
// visibile la firma dell'autore, con link alla sua home page.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { isInglese } from './lingua';

const en = isInglese(Astro.url);
---

<div class="titolo-con-autore">
	<Default><slot /></Default>
	<a class="autore" href={en ? 'https://www.giuseppebosi.com/en/' : 'https://www.giuseppebosi.com'}>{en ? 'by Prof. Giuseppe Bosi' : 'Prof. Giuseppe Bosi'}</a>
</div>

<style>
	.titolo-con-autore {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.1rem;
		min-width: 0;
		line-height: 1.2;
	}

	.autore {
		font-size: var(--sl-text-xs);
		font-weight: 500;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		white-space: nowrap;
	}

	.autore:hover {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
	}
</style>
